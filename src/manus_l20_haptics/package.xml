<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manus_l20_haptics</name>
  <version>0.1.0</version>
  <description>Bridge LinkerHand L20 tactile force feedback to MANUS glove vibration motors.</description>
  <maintainer email="huangzizhe@example.com">huangzizhe</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>manus_ros2_msgs</exec_depend>
  <exec_depend>linker_hand_ros2_sdk</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
